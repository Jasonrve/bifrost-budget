# Copy to .env for local development. Never commit real values.

BIFROST_API_BASE_URL=https://bifrost.example.com
BIFROST_ADMIN_API_KEY=

# Required for the default Entra delegated-user provider. These are example-only values.
BIFROST_AUTH_PROVIDER=entra
BIFROST_ENTRA_TENANT_ID=
BIFROST_ENTRA_AUDIENCE=
BIFROST_ENTRA_SCOPE=Quota.Read
BIFROST_ENTRA_ISSUER=
BIFROST_ENTRA_DISCOVERY_URL=
BIFROST_ENTRA_JWKS_URL=
# JSON object: {"<tenant-guid>:<user-guid>":"<exact-bifrost-user-id>"}
BIFROST_ENTRA_USER_MAP={}

# Ping is available only when explicitly selected and fully configured.
# BIFROST_AUTH_PROVIDER=ping
# BIFROST_PING_ISSUER=
# BIFROST_PING_AUDIENCE=
# BIFROST_PING_DISCOVERY_URL=
# BIFROST_PING_JWKS_URL=
# BIFROST_PING_SCOPE=

# Optional
# BIFROST_USERINFO_URL=https://identity.example.invalid/as/userinfo
# BIFROST_QUOTA_PATH=/api/governance/virtual-keys/quota
# BIFROST_USERS_PATH=/api/governance/users?limit=20
# BIFROST_TRANSPORT=streamable-http
# BIFROST_HOST=0.0.0.0
# BIFROST_PORT=8080
# BIFROST_MCP_PATH=/mcp
# BIFROST_TIMEOUT_SECONDS=15
# BIFROST_LOG_LEVEL=INFO
